<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.syy.taskflowinsight.it</groupId>
    <artifactId>compatibility-matrix-consumer</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tfi.matrix.consumer.group>UNSET</tfi.matrix.consumer.group>
        <tfi.matrix.consumer.artifact>UNSET</tfi.matrix.consumer.artifact>
        <tfi.matrix.consumer.version>UNSET</tfi.matrix.consumer.version>
        <tfi.matrix.dependency.group>UNSET</tfi.matrix.dependency.group>
        <tfi.matrix.dependency.artifact>UNSET</tfi.matrix.dependency.artifact>
        <tfi.matrix.dependency.version>UNSET</tfi.matrix.dependency.version>
        <tfi.matrix.consumer.class>UNSET</tfi.matrix.consumer.class>
        <tfi.matrix.dependency.class>UNSET</tfi.matrix.dependency.class>
        <tfi.matrix.consumer.manifest>UNSET</tfi.matrix.consumer.manifest>
        <tfi.matrix.dependency.manifest>UNSET</tfi.matrix.dependency.manifest>
        <tfi.matrix.repository>UNSET</tfi.matrix.repository>
        <tfi.matrix.row-key>UNSET</tfi.matrix.row-key>
        <tfi.matrix.expected>UNSET</tfi.matrix.expected>
        <tfi.matrix.enforcement>UNSET</tfi.matrix.enforcement>
        <tfi.matrix.codesource.output>UNSET</tfi.matrix.codesource.output>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${tfi.matrix.consumer.group}</groupId>
            <artifactId>${tfi.matrix.consumer.artifact}</artifactId>
            <version>${tfi.matrix.consumer.version}</version>
        </dependency>
        <dependency>
            <groupId>${tfi.matrix.dependency.group}</groupId>
            <artifactId>${tfi.matrix.dependency.artifact}</artifactId>
            <version>${tfi.matrix.dependency.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>3.5.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>matrix-dependency-convergence</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence>
                                    <includes>
                                        <include>${tfi.matrix.dependency.group}:${tfi.matrix.dependency.artifact}</include>
                                    </includes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <tfi.matrix.consumer.class>${tfi.matrix.consumer.class}</tfi.matrix.consumer.class>
                        <tfi.matrix.dependency.class>${tfi.matrix.dependency.class}</tfi.matrix.dependency.class>
                        <tfi.matrix.consumer.manifest>${tfi.matrix.consumer.manifest}</tfi.matrix.consumer.manifest>
                        <tfi.matrix.dependency.manifest>${tfi.matrix.dependency.manifest}</tfi.matrix.dependency.manifest>
                        <tfi.matrix.repository>${tfi.matrix.repository}</tfi.matrix.repository>
                        <tfi.matrix.row-key>${tfi.matrix.row-key}</tfi.matrix.row-key>
                        <tfi.matrix.expected>${tfi.matrix.expected}</tfi.matrix.expected>
                        <tfi.matrix.enforcement>${tfi.matrix.enforcement}</tfi.matrix.enforcement>
                        <tfi.matrix.codesource.output>${tfi.matrix.codesource.output}</tfi.matrix.codesource.output>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
