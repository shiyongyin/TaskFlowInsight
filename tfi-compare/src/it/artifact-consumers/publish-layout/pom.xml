<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.syy.taskflowinsight.it</groupId>
    <artifactId>publish-layout-consumer</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tfi.version>UNSET</tfi.version>
        <tfi.repository>UNSET</tfi.repository>
        <tfi.expected.artifacts>UNSET</tfi.expected.artifacts>
        <tfi.expected.repository>UNSET</tfi.expected.repository>
    </properties>

    <repositories>
        <repository>
            <id>publish-layout</id>
            <url>${tfi.repository}</url>
            <releases>
                <enabled>true</enabled>
                <checksumPolicy>fail</checksumPolicy>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.syy</groupId>
            <artifactId>TaskFlowInsight</artifactId>
            <version>${tfi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>verify-publish-layout</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.syy.taskflowinsight.it.PublishLayoutConsumer</mainClass>
                            <classpathScope>runtime</classpathScope>
                            <arguments>
                                <argument>${tfi.expected.artifacts}</argument>
                                <argument>${tfi.expected.repository}</argument>
                                <argument>${tfi.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <systemPropertyVariables>
                        <tfi.expected.artifacts>${tfi.expected.artifacts}</tfi.expected.artifacts>
                        <tfi.expected.repository>${tfi.expected.repository}</tfi.expected.repository>
                        <tfi.expected.version>${tfi.version}</tfi.expected.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
