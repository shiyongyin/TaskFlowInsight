<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.syy.taskflowinsight.it</groupId>
        <artifactId>artifact-consumers</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>baseline-upgrade-rollback-consumer</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <tfi.it.phase>${tfi.it.phase}</tfi.it.phase>
                        <tfi.it.expected.version>${tfi.it.expected.version}</tfi.it.expected.version>
                        <tfi.it.expected.repository>${tfi.it.expected.repository}</tfi.it.expected.repository>
                        <tfi.it.expected.sha.manifest>${tfi.it.expected.sha.manifest}</tfi.it.expected.sha.manifest>
                        <tfi.it.codesource.output>${tfi.it.codesource.output}</tfi.it.codesource.output>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>baseline</id>
            <dependencies>
                <dependency>
                    <groupId>com.syy</groupId>
                    <artifactId>TaskFlowInsight</artifactId>
                    <version>3.0.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>candidate</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.syy</groupId>
                    <artifactId>TaskFlowInsight</artifactId>
                    <version>${tfi.candidate.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mixed</id>
            <dependencies>
                <dependency>
                    <groupId>com.syy</groupId>
                    <artifactId>tfi-compare</artifactId>
                    <version>3.0.0</version>
                </dependency>
                <dependency>
                    <groupId>com.syy</groupId>
                    <artifactId>tfi-compare-spring-starter</artifactId>
                    <version>${tfi.candidate.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>reject-mixed-tfi-compare-versions</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <dependencyConvergence>
                                            <includes>
                                                <include>com.syy:tfi-compare</include>
                                            </includes>
                                        </dependencyConvergence>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
